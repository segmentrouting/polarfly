- version: 2
  interfaces: ["{{ src_host.interfaces[0].name }}", "{{ src_host.interfaces[1].name }}"]
  port_limit: 2
  port_info:
    - ip: {{ src_host.interfaces[0].ipv4 }}
      default_gw: {{ src_host.interfaces[0].ipv4_gw }}
      ip6: {{ src_host.interfaces[0].ipv6 }}
      default_gw6: {{ src_host.interfaces[0].ipv6_gw }}
      ipv6_autocfg: true
      src_ipv6_enabled: true
      ipv6_nd_enabled: true
      ipv6_subnet: {{ src_host.interfaces[0].ipv6_subnet }}
    - ip: {{ src_host.interfaces[1].ipv4 }}
      default_gw: {{ src_host.interfaces[1].ipv4_gw }}
      ip6: {{ src_host.interfaces[1].ipv6 }}
      default_gw6: {{ src_host.interfaces[1].ipv6_gw }}
      ipv6_autocfg: true
      src_ipv6_enabled: true
      ipv6_nd_enabled: true
      ipv6_subnet: {{ src_host.interfaces[1].ipv6_subnet }} 